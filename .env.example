# Copia este archivo a .env y ajusta los valores. .env NO se sube a Git.
# La anon key es pública por diseño. La service_role NUNCA va aquí ni en el cliente.
# Local: ejecuta `npm run db:status` y copia "API URL" y "anon key". En Cloudflare Pages van como variables de entorno.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
